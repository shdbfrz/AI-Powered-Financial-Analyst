# ============================================================
# AI-Powered Financial Analyst — Environment Variables (example)
# Copy this file to .env and fill in real values. Never commit .env
# ============================================================

# ---- App ----
ENVIRONMENT=development           # development | staging | production
DEBUG=true
SECRET_KEY=change-me-to-a-random-64-char-string
API_V1_PREFIX=/api/v1

# ---- Database (PostgreSQL) ----
POSTGRES_USER=fin_analyst
POSTGRES_PASSWORD=change-me
POSTGRES_DB=fin_analyst_db
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
DATABASE_URL=postgresql+asyncpg://fin_analyst:change-me@localhost:5432/fin_analyst_db

# ---- Redis (optional, caching / rate limiting / task queue) ----
REDIS_URL=redis://localhost:6379/0

# ---- Auth (JWT) ----
JWT_SECRET_KEY=change-me-jwt-secret
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# ---- Market Data Providers ----
DATA_PROVIDER=yahoo_finance        # yahoo_finance | alpha_vantage | polygon | twelve_data
ALPHA_VANTAGE_API_KEY=
POLYGON_API_KEY=
TWELVE_DATA_API_KEY=

# ---- News / Sentiment ----
NEWS_API_KEY=

# ---- LLM Providers ----
LLM_PROVIDER=groq                  # gemini | groq | openrouter
GEMINI_API_KEY=
GROQ_API_KEY=
OPENROUTER_API_KEY=

# ---- Data Collection Module (ai/data_collection) ----
LOG_LEVEL=INFO                     # DEBUG | INFO | WARNING | ERROR
REQUEST_TIMEOUT_SECONDS=15
REQUEST_MAX_RETRIES=3
REQUEST_BACKOFF_FACTOR=2.0
CACHE_TTL_SECONDS=3600

# ---- Frontend ----
VITE_API_BASE_URL=http://localhost:8000/api/v1
